{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "evaluator_id",
    "scenario_id",
    "model",
    "reasoning",
    "settings_id",
    "environment_id",
    "baseline",
    "candidate"
  ],
  "properties": {
    "evaluator_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "reasoning": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "settings_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "environment_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "baseline": {
      "type": "object",
      "required": [
        "run_id",
        "consumed_files",
        "cases",
        "evidence"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "consumed_files": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "cases": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "id",
              "outcome"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "outcome": {
                "enum": [
                  "PASS",
                  "FAIL"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": [
        "run_id",
        "consumed_files",
        "cases",
        "evidence"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "consumed_files": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "cases": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "id",
              "outcome"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "outcome": {
                "enum": [
                  "PASS",
                  "FAIL"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
