{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "category",
    "developer_id",
    "inspector_id",
    "observations",
    "hypothesis",
    "reproduction",
    "evidence"
  ],
  "properties": {
    "category": {
      "enum": [
        "code",
        "environment",
        "harness",
        "unknown"
      ]
    },
    "developer_id": {
      "type": "string",
      "minLength": 1
    },
    "inspector_id": {
      "type": "string",
      "minLength": 1
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "reproduction": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    }
  },
  "additionalProperties": false
}
