{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "kind",
    "task_ref",
    "metadata",
    "evidence"
  ],
  "properties": {
    "kind": {
      "enum": [
        "file_read",
        "tool_call",
        "error",
        "workflow"
      ]
    },
    "task_ref": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
