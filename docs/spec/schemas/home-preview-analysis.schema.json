{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "home-preview-analysis-v1",
  "type": "object",
  "properties": {
    "summary": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "available",
            "partial",
            "missing",
            "unverified",
            "error"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "as_of": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "data": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                }
              },
              "required": [
                "text",
                "evidence_ids"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "reason",
        "as_of",
        "source_ids",
        "data"
      ],
      "additionalProperties": false
    },
    "key_points": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "available",
            "partial",
            "missing",
            "unverified",
            "error"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "as_of": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "data": {
          "anyOf": [
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1
                  }
                },
                "required": [
                  "title",
                  "description",
                  "evidence_ids"
                ],
                "additionalProperties": false
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "reason",
        "as_of",
        "source_ids",
        "data"
      ],
      "additionalProperties": false
    },
    "ai_prediction": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "available",
            "partial",
            "missing",
            "unverified",
            "error"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "as_of": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "data": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "home_goals": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 30
                },
                "away_goals": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 30
                },
                "confidence": {
                  "type": "string",
                  "enum": [
                    "low",
                    "medium",
                    "high"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                }
              },
              "required": [
                "home_goals",
                "away_goals",
                "confidence",
                "reason",
                "evidence_ids"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "reason",
        "as_of",
        "source_ids",
        "data"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "summary",
    "key_points",
    "ai_prediction"
  ],
  "additionalProperties": false
}
