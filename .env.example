# 로컬 개발 기본값입니다. 실제 비밀값을 이 파일에 넣지 말고 복사본을 .env로 두세요.

# 개발 세션 쓰기 연결입니다. 세션 행만 preview_dev 스키마에 쓰는 전용 역할을 씁니다.
# 이 역할은 public 영역에 쓰기 권한이 없습니다(scripts/preview_dev_provision.py로 생성).
PREVIEW_DATABASE_URL=postgresql+psycopg://preview:preview_local_dev@127.0.0.1:55432/preview_mp01_dev

# 기존 운영 계정(public.app_user) 읽기 전용 연결입니다. 비워 두면 위 개발 DB를 씁니다.
# 실제 값은 저장소 밖 0600 파일에 두고 scripts/run_preview_dev.sh로 주입합니다.
PREVIEW_IDENTITY_DATABASE_URL=

# dev | test | prod
PREVIEW_ENV=dev

# 세션 수명(초). 개발 기본 8시간.
PREVIEW_SESSION_TTL_SECONDS=28800

# HTTPS 배포에서만 true로 바꿉니다. 로컬 http 개발에서는 false입니다.
PREVIEW_COOKIE_SECURE=false

# 로컬이 아닌 DB를 명시적으로 허용할 때만 1로 설정합니다. 두 연결을 따로 엽니다.
# 이 플래그만 켜는 것으로 운영 접속 준비가 끝났다고 간주하지 않습니다.
PREVIEW_ALLOW_NONLOCAL_DB=0
PREVIEW_ALLOW_NONLOCAL_IDENTITY_DB=0
