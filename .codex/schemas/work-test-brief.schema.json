{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "criterion_id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "criterion_id",
          "description"
        ],
        "additionalProperties": true
      },
      "minItems": 1
    }
  },
  "required": [
    "goal",
    "scenarios"
  ],
  "additionalProperties": true
}
