{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchmark.local/schemas/feature-flow.schema.json",
  "title": "Benchmark Feature Flow State",
  "type": "object",
  "required": [
    "feature_id",
    "tasklist_id",
    "current_stage",
    "feature",
    "phase",
    "state",
    "owner",
    "iteration",
    "endpoint_requests",
    "be_dependency_state",
    "artifacts",
    "evidence",
    "gates",
    "blockers",
    "next_action"
  ],
  "properties": {
    "feature_id": { "type": "string", "minLength": 1 },
    "tasklist_id": { "type": ["string", "null"] },
    "current_stage": { "$ref": "#/$defs/state" },
    "feature": {
      "type": "object",
      "required": ["title", "requirements_doc"],
      "properties": {
        "title": { "type": "string" },
        "requirements_doc": { "type": "string" }
      },
      "additionalProperties": true
    },
    "phase": { "enum": ["mock", "integration"] },
    "state": { "$ref": "#/$defs/state" },
    "owner": {
      "enum": ["fe-planner", "fe-dev", "fe-reviewer", "team-lead"]
    },
    "iteration": {
      "type": "object",
      "required": ["plan_review_loop", "playwright_loop", "review_loop", "integration_loop"],
      "properties": {
        "plan_review_loop": { "type": "integer", "minimum": 0 },
        "playwright_loop": { "type": "integer", "minimum": 0 },
        "review_loop": { "type": "integer", "minimum": 0 },
        "integration_loop": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "endpoint_requests": { "type": "array", "items": { "type": "string" } },
    "be_dependency_state": { "type": "object" },
    "artifacts": { "type": "object" },
    "evidence": { "type": "object" },
    "gates": { "type": "object" },
    "blockers": { "type": "array" },
    "next_action": {
      "type": "object",
      "required": ["agent", "command"],
      "properties": {
        "agent": { "type": ["string", "null"] },
        "command": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$defs": {
    "state": {
      "enum": [
        "TRIGGERED",
        "PLAN_DRAFTING",
        "PLAN_REVIEW",
        "PLAN_APPROVED",
        "PLAN_FAILED",
        "IMPL_IN_PROGRESS",
        "IMPL_PUSHED",
        "PLAYWRIGHT_RUN",
        "REVIEW_PENDING",
        "CHANGES_REQUESTED",
        "MERGE_GATE",
        "PR_CREATED",
        "MERGED",
        "BE_REQUEST_GENERATED",
        "FE_DONE_AWAITING_BE",
        "INTEGRATION_TRIGGERED",
        "INTEGRATION_IN_PROGRESS",
        "INTEGRATION_PUSHED",
        "L3_RUN",
        "INTEGRATION_FAILED",
        "L4_SMOKE",
        "DONE",
        "ESCALATED"
      ]
    }
  }
}
